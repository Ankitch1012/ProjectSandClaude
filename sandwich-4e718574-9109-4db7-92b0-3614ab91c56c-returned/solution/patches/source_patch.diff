+    projected = { x: point.x, y: 740 - point.y };
+  } else if (record.orientation.front === 'east') {
+    projected = { x: point.y * (1000 / 740), y: point.x * (740 / 1000) };
+  } else if (record.orientation.front === 'west') {
+    projected = { x: (740 - point.y) * (1000 / 740), y: (1000 - point.x) * (740 / 1000) };
+  } else {
+    projected = { x: point.x, y: point.y };
+  }
+  return record.orientation.mirrorX
+    ? { x: 1000 - projected.x, y: projected.y }
+    : projected;
 }
 
